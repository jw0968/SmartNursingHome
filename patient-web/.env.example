# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

VITE_PATIENT_ID=patient-001
VITE_CAMERA_ID=cam-01

# Firebase web app config (Firebase Console -> Project settings -> General -> Your apps -> Web app).
# Leave these blank to run in FAKE mode, which logs writes to the browser console instead of Firebase.
VITE_FIREBASE_API_KEY="INPUT_YOUR_OWN_KEY_HERE"
VITE_FIREBASE_AUTH_DOMAIN="INPUT_YOUR_OWN_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://INPUT_YOUR_OWN_PROJECT_ID-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="INPUT_YOUR_OWN_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="INPUT_YOUR_OWN_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="INPUT_YOUR_OWN_SENDER_ID"
VITE_FIREBASE_APP_ID="INPUT_YOUR_OWN_APP_ID"
